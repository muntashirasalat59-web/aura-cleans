# Supabase (same project as backend) — Vite exposes VITE_* to the client
VITE_SUPABASE_URL=https://nfrvbmqhyxsjaonuhlum.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key_here

# Required for login: copy SUPABASE_ANON_KEY from backend/.env (same anon key).
# Create users in Supabase Auth, then add a matching row in user_profiles (see backend/database/supabase.migration.user_profiles.sql).

# New signups must confirm email. In Supabase Dashboard:
# Authentication → Providers → Email → Enable email confirmations = ON
# Authentication → URL Configuration → Redirect URLs include http://localhost:5173/login
# (and your production origin, e.g. https://your-app.vercel.app/login)

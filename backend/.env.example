# Supabase — copy to .env and fill in values (Project Settings → API)
SUPABASE_URL=https://nfrvbmqhyxsjaonuhlum.supabase.co
SUPABASE_ANON_KEY=your_anon_key_here

# Required for login profile lookup + Admin → Users. Keep secret — server only.
# Without this, /api/auth/me relies on RLS with the user JWT (must match frontend project keys).
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

PORT=5000
